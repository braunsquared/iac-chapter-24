---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
---

<Layout>
  <Nav />
  <header class="section flex_vertical">
    <div class="container">
      <div id="w-node-_09839d25-dee8-b0c4-db66-e2386b6eb623-590b6ce6" class="header w-node-_9ff42de2-d140-8f9c-353f-5357710de7ac-79098339">
        <div class="w-layout-grid grid_5-col gap-medium">
          <h1 id="w-node-_557f97cd-433b-e6ae-0ca0-e83d590b6cea-590b6ce6" class="heading_h1 margin-bottom_none w-node-_9ff42de2-d140-8f9c-353f-5357710de7a2-79098339">
            Join IAC&nbsp;Chapter 24
          </h1><div id="w-node-_557f97cd-433b-e6ae-0ca0-e83d590b6cec-590b6ce6" class="w-node-_9ff42de2-d140-8f9c-353f-5357710de7aa-79098339">
            <p class="paragraph_large text-color_secondary margin-bottom_small">
              Want to become a pilot? Interested in learning Aerobatics? Want to take a ride in an aerobatic plane? Looking for spin training? &nbsp;Let us know! Send us a message,
              we can set you up with the right person to achieve your goals. Join the Lone Star Aerobatic Club today!
            </p><div class="button-group"><a href="#payment" class="button w-button">Pay Dues</a><a href="#contact" class="button is-secondary w-button">Contact us</a></div>
          </div>
        </div>
      </div><img
        class="image_cover ratio_3x2 w-node-_9ff42de2-d140-8f9c-353f-5357710de7ad-79098339"
        src="https://cdn.prod.website-files.com/689b97dc9ac4051f8ce1c2a4/69a32af7fe3d8388efc99c15_wingwalker.jpg"
        width="1216"
        height="832"
        alt="image of ballroom dance"
        sizes="100vw"
        data-aisg-image-id="daedf03c-eba6-4cc6-a443-01ee82e95d4a"
        id="w-node-_557f97cd-433b-e6ae-0ca0-e83d590b6cf6-590b6ce6"
        loading="lazy"
        srcset="https://cdn.prod.website-files.com/689b97dc9ac4051f8ce1c2a4/69a32af7fe3d8388efc99c15_wingwalker-p-500.jpg 500w, https://cdn.prod.website-files.com/689b97dc9ac4051f8ce1c2a4/69a32af7fe3d8388efc99c15_wingwalker-p-800.jpg 800w, https://cdn.prod.website-files.com/689b97dc9ac4051f8ce1c2a4/69a32af7fe3d8388efc99c15_wingwalker-p-1080.jpg 1080w, https://cdn.prod.website-files.com/689b97dc9ac4051f8ce1c2a4/69a32af7fe3d8388efc99c15_wingwalker-p-1600.jpg 1600w, https://cdn.prod.website-files.com/689b97dc9ac4051f8ce1c2a4/69a32af7fe3d8388efc99c15_wingwalker-p-2000.jpg 2000w, https://cdn.prod.website-files.com/689b97dc9ac4051f8ce1c2a4/69a32af7fe3d8388efc99c15_wingwalker-p-2600.jpg 2600w, https://cdn.prod.website-files.com/689b97dc9ac4051f8ce1c2a4/69a32af7fe3d8388efc99c15_wingwalker-p-3200.jpg 3200w, https://cdn.prod.website-files.com/689b97dc9ac4051f8ce1c2a4/69a32af7fe3d8388efc99c15_wingwalker.jpg 3288w"
      />
    </div>
  </header>
  <section id="payment" class="section is-secondary">
    <div class="container">
      <div class="header is-align-center">
        <div class="eyebrow">Membership Dues</div><h2 class="heading_h1">Choose your flight path</h2><p class="subheading">
          Annual chapter dues are $30 per year. You must also be a member of the EAA&nbsp;and IAC.
        </p>
      </div><ul role="list" class="grid_4-col gap-xsmall w-list-unstyled">
        <li class="card on-secondary">
          <div class="card_body_small">
            <div class="margin-bottom_xsmall">
              <h3 class="heading_h4">One-time Payment</h3><p>Pay your annual dues using a one-time annual payment using either PayPal or your debit/credit card.</p>
            </div><div class="divider margin-bottom_xsmall"></div><p class="heading_h3">$30<span class="heading_h4">/yr</span></p><div
              class="w-layout-hflex flex_vertical is-y-center margin-bottom_small"
            >
              <div id="paypal-button-paynow"></div>
              <div id="paypal-button-paynow-thanks" style="display: none;"></div>
            </div>
          </div><li class="card is-featured on-secondary">
            <div class="card_body_small">
              <div class="margin-bottom_xsmall">
                <h3 class="heading_h4">Automatic Recurring Payment</h3><p>
                  Setup an annual recurring payment so you don't have to worry about remembering to pay again in the future.
                </p>
              </div><div class="divider margin-bottom_xsmall"></div><p class="heading_h3">$30<span class="heading_h4">/mo</span></p><div
                class="w-layout-hflex flex_vertical is-y-center margin-bottom_small"
              >
                <div id="paypal-button-subscribe"></div>
                <div id="paypal-button-subscribe-thanks" style="display: none;"></div>
              </div>
            </div>
          </li>
        </li>
        <script
          is:inline
          src="https://www.paypal.com/sdk/js?client-id=AetecJUEKO16Zd84lkW7hbJJC-xcMQW2OEGKSuF-c-Q0NPeDr4dg1qntw1cNmSKRBfzF3H9nOh9n9DAY&vault=true&disable-funding=paylater"
        ></script>
        <script is:inline>
          paypal
            .Buttons({
              style: {
                shape: 'pill',
                color: 'gold',
                layout: 'vertical',
                label: 'subscribe',
              },
              createSubscription: function (data, actions) {
                return actions.subscription.create({
                  plan_id: 'P-5CD96711NV332551EMPRIVLI',
                });
              },
              onApprove: function (data, actions) {
                document.getElementById('paypal-button-subscribe').style.display = 'none';
                document.getElementById('paypal-button-subscribe-thanks').style.display = 'block';
              },
            })
            .render('#paypal-button-subscribe');
          paypal
            .Buttons({
              style: {
                shape: 'pill',
                color: 'gold',
                layout: 'vertical',
                label: 'pay',
              },
              createOrder: function (data, actions) {
                return actions.order.create({
                  purchase_units: [{ description: 'IAC - Chapter 24 Annual Dues', amount: { currency_code: 'USD', value: 30 } }],
                });
              },
              onApprove: function (data, actions) {
                return actions.order.capture().then(function (orderData) {
                  document.getElementById('paypal-button-paynow').style.display = 'none';
                  document.getElementById('paypal-button-paynow-thanks').style.display = 'block';
                });
              },
              onError: function (err) {
                console.log(err);
              },
            })
            .render('#paypal-button-paynow');
        </script>
      </ul>
    </div>
  </section>
  <Contact />
  <Footer />
</Layout>
