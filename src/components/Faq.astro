---
import { faqContent, faqItems } from '../data/content';
---

<section id="faq" class="section">
  <div class="container">
    <div id="w-node-c08a178d-39e1-35d8-4f34-2b7bc1865c72-c1865c6f" class="header w-node-_333aa81d-ef16-84da-bd4a-d1c23d1424a4-8ce1c2ab">
      <div class="eyebrow">{faqContent.eyebrow}</div>
      <h2>{faqContent.heading}</h2>
      <p class="subheading">{faqContent.description}</p>
    </div>
    <div id="w-node-b9a4e631-bad5-4935-a3b3-9d0d1667b0e8-c1865c6f" class="flex_horizontal flex_vertical gap-small w-node-_333aa81d-ef16-84da-bd4a-d1c23d1424c7-8ce1c2ab">
      {faqItems.map(item => (
        <div class="divider">
          <div class="w-layout-grid grid_2-col gap-small">
            <div class="heading_h4">{item.question}</div>
            <div class="rich-text paragraph_large w-richtext">
              <p>{item.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
