---
import { Image } from 'astro:assets';
import timothyBraun from '../assets/img/timothy-braun.avif';
import boKalabus from '../assets/img/bo-kalabus.avif';
import tomRhodes from '../assets/img/tom-rhodes.avif';
import { testimonials } from '../data/content';

const images = [timothyBraun, boKalabus, tomRhodes];
---

<section id="testimonials" class="section is-secondary">
  <div class="container">
    <div class="grid_3-col gap-medium w-tabs">
      <div id="w-node-dc19b400-f9c1-4517-60c4-f14d8cd0f410-8cd0f40d" class="flex_horizontal flex_vertical w-node-_7331c66d-2822-5380-ccae-53a6b00d0b93-8ce1c2ab w-tab-menu">
        {testimonials.map((t, i) => (
          <a data-w-tab={`Tab ${i + 1}`} class:list={['tab_menu-button text-align_center w-tab-link', { 'w--current': i === testimonials.length - 1 }]}>
            <div class="logo"><div>{t.role}</div></div>
          </a>
        ))}
      </div>
      <div id="w-node-dc19b400-f9c1-4517-60c4-f14d8cd0f41a-8cd0f40d" class="tabs_content w-node-_7331c66d-2822-5380-ccae-53a6b00d0baf-8ce1c2ab w-tab-content">
        {testimonials.map((t, i) => (
          <div data-w-tab={`Tab ${i + 1}`} class:list={['w-tab-pane', { 'w--tab-active': i === testimonials.length - 1 }]}>
            <div class="avatar margin-bottom_medium">
              <Image
                width={64}
                height={64}
                alt={`Headshot of ${t.name}`}
                src={images[i]}
                loading="lazy"
                class="image_cover"
              />
            </div>
            <p class="paragraph_xlarge margin-bottom_medium">{t.quote}</p>
            <div>{t.name}</div>
            <div>{t.role}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const testimonialTabs = document.querySelector('#testimonials .w-tab-menu');
  const testimonialLinks = testimonialTabs?.querySelectorAll('.w-tab-link');
  const testimonialPanes = document.querySelectorAll('#testimonials .w-tab-pane');

  testimonialLinks?.forEach(link => {
    link.addEventListener('click', e => {
      e.preventDefault();
      const tabId = link.getAttribute('data-w-tab');

      testimonialLinks.forEach(l => l.classList.remove('w--current'));
      link.classList.add('w--current');

      testimonialPanes.forEach(pane => {
        if (pane.getAttribute('data-w-tab') === tabId) {
          pane.classList.add('w--tab-active');
        } else {
          pane.classList.remove('w--tab-active');
        }
      });
    });
  });
</script>
