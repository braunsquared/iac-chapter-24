---
import { Image } from 'astro:assets';
import everyone from '../assets/img/Everyone-scaled.jpg';
import img2790 from '../assets/img/IMG_2790-scaled.jpeg';
import img2015 from '../assets/img/20150613_0826171_zpsp2fukfcq.jpg';
import briefing from '../assets/img/Briefing-scaled.jpg';
import { discoverIntro, tabs } from '../data/content';

const tabImages = [everyone, img2790, img2015, briefing];
---

<section id="discover" class="section is-secondary">
  <div id="w-node-_0c14111e-83c1-e0a2-d0e7-73feb7199d5b-2d40cb18" class="container is-small w-node-a4b5b2e2-f43a-e57c-a491-06c290db1eb5-8ce1c2ab">
    <div class="header is-align-center">
      <div class="eyebrow margin-bottom_xsmall text-color_secondary">{discoverIntro.eyebrow}</div>
      <h2 class="heading_h2">{discoverIntro.heading}</h2>
      <p class="subheading">{discoverIntro.description}</p>
    </div>
  </div>
  <div class="container margin-top_medium">
    <div class="grid_1-col w-tabs">
      <div id="w-node-_4f16d1c1-f5bd-cf42-6e56-2a3d3a3b49f4-2d40cb18" class="grid_4-col gap-xsmall w-node-a4b5b2e2-f43a-e57c-a491-06c290db1eca-8ce1c2ab w-tab-menu">
        <a data-w-tab="Tab 1" class="tab_menu-link_transparent-bottom w-tab-link w--current"
          ><div class="heading_h5">Competitions</div>
          <p class="paragraph_small text-color_secondary">
            Experience the thrill of friendly competition and connect with fellow pilots at our signature aerobatic gatherings. All skill levels are welcome to join the excitement.
          </p></a
        ><a data-w-tab="Tab 2" class="tab_menu-link_transparent-bottom w-tab-link"
          ><div class="heading_h5">Fly Days</div>
          <p class="paragraph_small text-color_secondary">
            Advance your flying by joining us for our 2nd Saturday Fly Days, practical safety tips, and mentorship from passionate, experienced community members.
          </p></a
        ><a data-w-tab="Tab 3" class="tab_menu-link_transparent-bottom w-tab-link"
          ><div class="heading_h5">Events</div>
          <p class="paragraph_small text-color_secondary">Engage with other club members at club sponsored events, deepen your knowledge, and master new maneuvers.</p></a
        ><a data-w-tab="Tab 4" class="tab_menu-link_transparent-bottom w-tab-link"
          ><div class="heading_h5">Community</div>
          <p class="paragraph_small text-color_secondary">Find your crew—share stories, swap tips, and grow alongside a welcoming group of pilots who love to fly.</p></a
        >
      </div>
      <div class="tabs_content margin-bottom_small w-tab-content">
        <div data-w-tab="Tab 1" class="w-tab-pane w--tab-active">
          <div class="w-layout-grid grid_5-col gap-xsmall">
            <Image
              alt="a group of people standing in front of an airplane"
              src={everyone}
              loading="lazy"
              id="w-node-_4f16d1c1-f5bd-cf42-6e56-2a3d3a3b4a0c-2d40cb18"
              class="image image_cover ratio_3x2 w-node-a4b5b2e2-f43a-e57c-a491-06c290db1ecb-8ce1c2ab"
              quality={80}
              densities={[1.5, 2]}
            />
            <div id="w-node-_4f16d1c1-f5bd-cf42-6e56-2a3d3a3b4a0d-2d40cb18" class="card on-secondary w-node-a4b5b2e2-f43a-e57c-a491-06c290db1ed4-8ce1c2ab">
              <div class="card_body flex_vertical">
                <div class="heading_h4">Join us in friendly competition</div>
                <p class="paragraph_small">
                  Mark your calendar for our next aerobatic event! Enjoy supportive competition, expert feedback, and a chance to celebrate your progress with friends.
                </p>
                <div class="margin_top-auto padding-top_xsmall"><a href="/#join" class="button is-secondary w-button">Register</a></div>
              </div>
            </div>
          </div>
        </div>
        <div data-w-tab="Tab 2" class="w-tab-pane">
          <div class="w-layout-grid grid_5-col gap-xsmall">
            <Image
              style="width: auto; height: auto;"
              class="image image_cover ratio_3x2 w-node-a4b5b2e2-f43a-e57c-a491-06c290db1ed7-8ce1c2ab"
              src={img2790}
              alt="a group of people standing in front of an airplane"
              sizes="100vw"
              id="w-node-c8def9c0-aa38-1e19-8fe2-c7e5946fbd24-2d40cb18"
              loading="lazy"
              quality={80}
              densities={[1.5, 2]}
            />
            <div id="w-node-c8def9c0-aa38-1e19-8fe2-c7e5946fbd25-2d40cb18" class="card on-secondary w-node-a4b5b2e2-f43a-e57c-a491-06c290db1ee0-8ce1c2ab">
              <div class="card_body flex_vertical">
                <div class="heading_h4">Second Saturday Fly Days</div>
                <p class="paragraph_small">
                  Join us at KGYI the second Saturday of every month (mostly, weather permitting), where we practice in an active aerobatic box. Get tips and feedback from other
                  club members.
                </p>
                <div class="margin_top-auto padding-top_xsmall"><a href="/#join" class="button is-secondary w-button">Join now</a></div>
              </div>
            </div>
          </div>
        </div>
        <div data-w-tab="Tab 3" class="w-tab-pane">
          <div class="w-layout-grid grid_5-col gap-xsmall">
            <Image
              style="width: auto; height: auto;"
              class="image image_cover ratio_3x2 w-node-a4b5b2e2-f43a-e57c-a491-06c290db1ee3-8ce1c2ab"
              src={img2015}
              alt="a couple of airplanes leaving a hangar"
              id="w-node-_401237bc-e1c4-26d5-f026-513fe7a091b3-2d40cb18"
              loading="lazy"
              quality={80}
              densities={[1.5, 2]}
            />
            <div id="w-node-_401237bc-e1c4-26d5-f026-513fe7a091b4-2d40cb18" class="card on-secondary w-node-a4b5b2e2-f43a-e57c-a491-06c290db1eec-8ce1c2ab">
              <div class="card_body flex_vertical">
                <div class="heading_h4">Club Meetups</div>
                <p class="paragraph_small">
                  Join us for our club meetings where we get to socialize with other club members, family members and learn from guest speakers with a focus on safety, technique,
                  and advanced routines—perfect for pilots at any stage.
                </p>
                <div class="margin_top-auto padding-top_xsmall"><a href="/#join" class="button is-secondary w-button">Sign up</a></div>
              </div>
            </div>
          </div>
        </div>
        <div data-w-tab="Tab 4" class="w-tab-pane">
          <div class="w-layout-grid grid_5-col gap-xsmall">
            <Image
              style="width: auto; height: auto;"
              class="image image_cover ratio_3x2 w-node-a4b5b2e2-f43a-e57c-a491-06c290db1eef-8ce1c2ab"
              src={briefing}
              alt="a group of people sitting, listening to a briefing"
              id="w-node-_5275167e-ee25-e474-bcaf-1506447e98a3-2d40cb18"
              loading="lazy"
              quality={80}
              densities={[1.5, 2]}
            />
            <div id="w-node-_5275167e-ee25-e474-bcaf-1506447e98a4-2d40cb18" class="card on-secondary w-node-a4b5b2e2-f43a-e57c-a491-06c290db1ef8-8ce1c2ab">
              <div class="card_body flex_vertical">
                <div class="heading_h4">Connect and grow</div>
                <p class="paragraph_small">Share your journey, ask questions, and build lasting friendships with others who share your passion for aerobatics.</p>
                <div class="margin_top-auto padding-top_xsmall"><a href="/#join" class="button is-secondary w-button">Join us</a></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tabMenu = document.querySelector('.w-tab-menu');
  const tabLinks = tabMenu?.querySelectorAll('.w-tab-link');
  const tabPanes = document.querySelectorAll('.w-tab-pane');

  tabLinks?.forEach(link => {
    link.addEventListener('click', e => {
      e.preventDefault();
      const tabId = link.getAttribute('data-w-tab');

      tabLinks.forEach(l => l.classList.remove('w--current'));
      link.classList.add('w--current');

      tabPanes.forEach(pane => {
        if (pane.getAttribute('data-w-tab') === tabId) {
          pane.classList.add('w--tab-active');
        } else {
          pane.classList.remove('w--tab-active');
        }
      });
    });
  });
</script>
